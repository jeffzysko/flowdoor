# Supabase — projeto flowdoor-prod
NEXT_PUBLIC_SUPABASE_URL=https://ipcjrlgrxvqdwpofuzuz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app, usada nos links de comprovante e convite.
# Com www: o apex faz 308 para o www, e link torto em e-mail cheira a phishing.
NEXT_PUBLIC_SITE_URL=https://www.flowdoor.com.br

# Validação de foto por IA. Sem ela, toda comparação com a arte vira "incerto"
# e cai na fila de revisão — o campo não trava.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Envio de e-mail (Resend). Mesma conta que serve o SMTP do Supabase Auth.
# Sem esta chave o convite continua sendo criado — só não sai por e-mail, e a
# tela pede para mandar o link à mão. Só no servidor: NUNCA prefixar com
# NEXT_PUBLIC_.
RESEND_API_KEY=
